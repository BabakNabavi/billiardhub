# ═══════════════════════════════════════════════════════════════
# متغیرهای محیطی — نمونه. این فایل کامیت می‌شود؛ مقدارِ واقعی هرگز.
# ───────────────────────────────────────────────────────────────
# کپی بگیرید:  cp .env.example .env.local
#
# روی سرور، `deploy.sh` با --exclude='.env*' فایلِ واقعی را
# دست‌نخورده نگه می‌دارد. هیچ‌وقت `.env*` سرور را بازنویسی نکنید.
#
# ── چرا این فایل ساخته شد ──
# نشانیِ Supabase تا امروز یک مقدارِ پیش‌فرضِ هاردکد داشت، پس یک
# کلونِ تازه بدونِ تنظیمِ درست هم «کار می‌کرد» — ولی بی‌صدا به
# پروژه‌ی اشتباه وصل می‌شد. آن پیش‌فرض حذف شد و حالا نبودنِ متغیر
# خطای صریح می‌دهد؛ پس کلونِ تازه باید بداند چه چیزی لازم است.
# ═══════════════════════════════════════════════════════════════

# ── Supabase خودمیزبان (روی همان سرور، در داکر) ──
# نشانیِ عمومیِ سایت است، نه پروژه‌ی ابریِ supabase.co.
# اگر خالی بماند یا به *.supabase.co اشاره کند، اپ بالا نمی‌آید.
NEXT_PUBLIC_SUPABASE_URL=https://billiardhub.net
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── مسیرِ پایه‌ی API — همین اپ، پس نسبی ──
NEXT_PUBLIC_API_URL=/api

# ── نشست ──
JWT_SECRET=

# ── پیامک (ملی‌پیامک) ──
SMS_API_KEY=

# ── اعلانِ Web Push ──
VAPID_PRIVATE_KEY=

# ── نسخه‌ی پشتیبان (scripts/backup.mjs) — بیرون از دیسکِ پروژه ──
BH_BACKUP_DIR=

# ── درگاهِ ساختگی، فقط برای آزمایشِ محلی ──
# در تولید نباید تنظیم شود.
BH_ALLOW_MOCK_PAYMENTS=
