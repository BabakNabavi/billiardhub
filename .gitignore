# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
# الگوی عام است تا هر فایلِ env تازه‌ای (.env.production، .env.staging، …)
# هم خودبه‌خود بیرون بماند — فهرستِ نامیِ قبلی این‌ها را نمی‌گرفت.
.env*
!.env.example

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# یادداشت‌های محلی
Color code.txt

# ── فونت دانا: هرگز کامیت نشود ──
# فایل‌ها با مشخصات خریدار ساخته شده‌اند و شرایط لایسنس فونت‌ایران انتشار
# و اشتراک‌گذاری‌شان را ممنوع می‌کند، در حالی که این مخزن عمومی است.
# deploy.sh بسته را از پوشه‌ی کاری می‌سازد نه از گیت، پس به سرور می‌رسند.
# روی نسخه‌ای که تازه کلون شده فونت نیست و متن با Tahoma دیده می‌شود.
# نسخه‌ی اصلی: F:\Font - License\DanaPro(13Wt)
apps/web/public/fonts/Dana/

# گزارش‌های موقتِ Lighthouse
._lh-*.json
._x.json
._p*.json
._r*.json
._d*.json

# گزارشِ حذفِ فایل‌های یتیم — سابقه‌ی عملیاتی، نه کد.
# مخزن عمومی است و مسیرها ممکن است شناسه‌ی کاربر داشته باشند.
orphan-deleted-*.json

# ── نسخه‌های پشتیبان ──
# خروجیِ scripts/backup.mjs کد ملی و شماره کارت دارد. مخزن عمومی است؛
# یک بار رفتن به گیت یعنی برای همیشه در تاریخچه ماندن.
backups/
*.backup
*.dump

# ── خروجیِ Playwright MCP ──
# اسنپ‌شات، لاگِ کنسول و اسکرین‌شات‌های بازبینیِ ظاهری. ابزار این‌ها را
# در ریشه می‌سازد؛ سابقه‌ی یک نشستِ بازبینی‌اند، نه کد.
.playwright-mcp/
/*.png

# ابزارِ طراحی — ۳٫۵ مگابایت اسکیل و اسکریپتِ وندورشده.
# با `npx impeccable install` بازساخته می‌شود؛ در مخزن جا ندارد.
.claude/skills/impeccable/

# کشِ هوکِ impeccable — هر ویرایش بازنویسی می‌شود
apps/web/.impeccable/hook.cache.json
# Playwright CLI output (may contain credentials)
.playwright-cli/

# کلیدِ امضای اندروید — هر جای مخزن (مخزن عمومی است)
*.jks
*.keystore
*.p12
*.pk8
*.pepk
