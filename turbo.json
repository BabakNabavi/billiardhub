{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NODE_ENV",
        "SUPABASE_SERVICE_ROLE_KEY",
        "JWT_SECRET",
        "NID_HMAC_SECRET",
        "CRON_SECRET",
        "PAYMENT_PROVIDER",
        "PAYPING_TOKEN",
        "PAYPING_REVERSIBLE",
        "ZARINPAL_MERCHANT_ID",
        "SETTLEMENT_PROVIDER",
        "SAPIR_API_KEY",
        "SMS_API_KEY",
        "SMS_NOTIFICATIONS",
        "KAVENEGAR_API_KEY",
        "MELIPAYAMAK_KEY",
        "VAPID_PRIVATE_KEY",
        "BH_ALLOW_MOCK_PAYMENTS",
        "LOGIN_FAIL_THRESHOLD",
        "LOGIN_IP_THRESHOLD",
        "LOGIN_IP_WINDOWS",
        "LOGIN_LOCK_WINDOWS",
        "NEXT_TELEMETRY_DISABLED",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_BUILD_SHA",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}